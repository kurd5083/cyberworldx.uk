RewriteEngine On

# 1. Если URI — это корень сайта (/), отправляем на index.php
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /index.php [L]

# 2. Если запрашиваемый путь НЕ существует (ни файл, ни папка) — отдать index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
